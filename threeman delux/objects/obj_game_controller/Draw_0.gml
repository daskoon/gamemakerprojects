/**\n * WHAT: HUD & Visual Feedback.\n */\ndraw_set_color(c_white); \ndraw_text(10, 10, "STATE: " + gameState); \ndraw_text(10, 30, "TURN: " + players[turnIdx]); \nif (threeManIdx != -1) draw_text(10, 50, "3-MAN: " + players[threeManIdx]); \n\nif (gameState == "RESULTS") { \n    var _yy = 100; \n    for (var i = 0; i < array_length(lastResults.events); i++) { \n        draw_text(10, _yy, lastResults.events[i]); \n        _yy += 20; \n    } \n} \n\nif (gameState == "SPLASH") {\n    draw_set_halign(fa_center);\n    draw_text(room_width/2, room_height/2, "THREE MAN DELUXE - PRESS SPACE TO START");\n    draw_set_halign(fa_left);\n}