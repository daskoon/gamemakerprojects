/**\n * WHAT: The State Machine Loop.\n * WHY: To ensure deterministic transitions between game phases.\n */\nvar _confirm = keyboard_check_pressed(vk_space); \n\nswitch (gameState) { \n    case "SPLASH": \n        if (_confirm) gameState = "READY"; \n        break; \n    case "READY": \n        if (_confirm) { \n            gameState = "ROLLING"; \n            rollStartTime = current_time; \n            with (obj_dice) isRolling = true; \n        } \n        break; \n    case "ROLLING": \n        if (current_time - rollStartTime > 1000) { \n            gameState = "RESULTS"; \n            with (obj_dice) { \n                isRolling = false; \n                value = irandom_range(1, 6); \n                image_index = value - 1; \n            } \n            var _d1 = instance_find(obj_dice, 0).value; \n            var _d2 = instance_find(obj_dice, 1).value; \n            \n            // Evaluate the Commandments\n            lastResults = evaluateRules(_d1, _d2, players, turnIdx, threeManIdx, isVirgin, lawEngine); \n            threeManIdx = lastResults.newThreeManIdx; \n            isVirgin = false; \n        } \n        break; \n    case "RESULTS": \n        if (_confirm) { \n            gameState = "READY"; \n            turnIdx = (turnIdx + 1) % array_length(players); \n        } \n        break; \n}