/**\n * @description Snake Eyes: Rule Maker Engine.\n * WHO: Principal Architect (Agent) & The Boss (Skoon).\n * WHAT: Manages the lifecycle of player-created custom rules (Laws).\n * WHY: To isolate dynamic rule-making logic from the static core game commandments.\n */\nfunction LawEngine() constructor {\n    activeLaws = [];\n\n    /**\n     * WHAT: Law Enactor.\n     * WHY: To transform "Mad Libs" dropdown selections into a logic object.\n     */\n    static enact = function(_trigger, _target, _action) {\n        var _triggerText = string_replace(_trigger, "_", " ");\n        var _targetText = (_target == "threeman") ? "The 3-Man" : _target;\n        var _actionText = string_replace(_action, "_", " ");\n        var _label = "Whenever " + _triggerText + ", " + _targetText + " must " + _actionText;\n        \n        var _newLaw = {\n            trigger: _trigger,\n            target: _target,\n            action: _action,\n            label: _label\n        };\n        array_push(activeLaws, _newLaw);\n        return _newLaw;\n    };\n\n    /**\n     * WHAT: Law Evaluator.\n     * WHY: To check if any current roll triggers a custom law.\n     */\n    static evaluate = function(_v1, _v2, _total, _isDoubles) {\n        var _triggered = [];\n        for (var i = 0; i < array_length(activeLaws); i++) {\n            var _law = activeLaws[i];\n            var _isTriggered = false;\n            if (_law.trigger == "sum_5" && _total == 5) _isTriggered = true;\n            else if (_law.trigger == "sum_8" && _total == 8) _isTriggered = true;\n            else if (_law.trigger == "sum_9" && _total == 9) _isTriggered = true;\n            else if (_law.trigger == "sum_10" && _total == 10) _isTriggered = true;\n            else if (_law.trigger == "any_5" && (_v1 == 5 || _v2 == 5)) _isTriggered = true;\n            else if (_law.trigger == "any_6" && (_v1 == 6 || _v2 == 6)) _isTriggered = true;\n            else if (_law.trigger == "doubles" && _isDoubles) _isTriggered = true;\n            \n            if (_isTriggered) array_push(_triggered, _law);\n        }\n        return _triggered;\n    };\n\n    /**\n     * WHAT: Action Resolver.\n     * WHY: Maps law actions to specific penalty counts or state effects.\n     */\n    static resolvePenalty = function(_law) {\n        if (_law.action == "drink_3") return 3;\n        if (_law.action == "drink_2") return 2;\n        return 1;\n    };\n}