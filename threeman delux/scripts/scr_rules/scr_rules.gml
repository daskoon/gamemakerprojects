/**\n * @description The "Commandments" - Drinking Game Logic Engine.\n * WHO: Principal Architect (Agent) & The Boss (Skoon).\n * WHAT: Evaluates 3D dice faces against the official "Skoon Edition" rulebook.\n * WHY: To provide a central authority for all drinking penalties and state changes.\n */\nfunction evaluateRules(_v1, _v2, _players, _turnIdx, _threeManIdx, _isVirgin, _lawEngine) {\n    const _total = _v1 + _v2;\n    const _events = [];\n    const _penalties = [];\n    const _triggeredLaws = [];\n    var _newThreeManIdx = _threeManIdx;\n    var _threeManPenalty = false;\n    var _isDoubles = (_v1 == _v2);\n    var _isTitleChange = ((_v1 == 1 && _v2 == 2) || (_v1 == 2 && _v2 == 1));\n\n    // --- COMMANDMENT 1: THE THREE MAN (CURSE) ---\n    if (_threeManIdx != -1 && !_isTitleChange) {\n        var _p = 0;\n        if (_v1 == 3) _p++;\n        if (_v2 == 3) _p++;\n        if (_total == 3) _p++; \n        \n        if (_p > 0) {\n            array_push(_events, _players[_threeManIdx] + " DRINKS " + string(_p));\n            array_push(_penalties, { name: _players[_threeManIdx], count: _p, reason: "3-MAN CURSE" });\n            _threeManPenalty = true;\n        }\n    }\n\n    // --- COMMANDMENT 2: THE TITLE CHANGE (HOT POTATO) ---\n    if (_isTitleChange) {\n        _newThreeManIdx = _turnIdx;\n        array_push(_events, "NEW THREE MAN!");\n    }\n\n    // --- COMMANDMENT 3: SPECIALS (DOUBLES) ---\n    if (_isDoubles) {\n        if (_v1 == 3) array_push(_events, "DOUBLE 3s!");\n        if (_v1 == 5) array_push(_events, "DOUBLE 5s! THUMBS!");\n        if (_v1 == 1) array_push(_events, "SNAKE EYES! RULE!");\n        array_push(_events, "DOUBLES! CHALLENGE!");\n    }\n\n    // --- COMMANDMENT 4: SOCIALS & NEIGHBORS ---\n    if (_total == 4 || _v1 == 4 || _v2 == 4) {\n        array_push(_events, "4, SOCIAL, EVERYONE DRINK!");\n        for (var i = 0; i < array_length(_players); i++) {\n            array_push(_penalties, { name: _players[i], count: 1, reason: "SOCIAL" });\n        }\n    }\n    \n    if (_total == 7) {\n        var _left = (_turnIdx - 1 + array_length(_players)) % array_length(_players);\n        array_push(_events, "7 TO THE LEFT");\n        array_push(_penalties, { name: _players[_left], count: 1, reason: "LEFT" });\n    }\n    \n    if (_total == 11) {\n        var _right = (_turnIdx + 1) % array_length(_players);\n        array_push(_events, "11 TO THE RIGHT");\n        array_push(_penalties, { name: _players[_right], count: 1, reason: "RIGHT" });\n    }\n\n    // --- CUSTOM LAWS (MODULAR DELEGATION) ---\n    var _hits = _lawEngine.evaluate(_v1, _v2, _total, _isDoubles);\n    for (var i = 0; i < array_length(_hits); i++) {\n        var _law = _hits[i];\n        array_push(_triggeredLaws, _law.label);\n        array_push(_events, "CUSTOM LAW!");\n        \n        var _targetKey = _law.target;\n        var _drinkCount = _lawEngine.resolvePenalty(_law);\n        \n        if (_targetKey == "everyone") {\n            for (var j = 0; j < array_length(_players); j++) array_push(_penalties, { name: _players[j], count: _drinkCount, reason: "CUSTOM LAW" });\n        } else if (_targetKey == "roller") {\n            array_push(_penalties, { name: _players[_turnIdx], count: _drinkCount, reason: "CUSTOM LAW" });\n        } else if (_targetKey == "threeman" && _threeManIdx != -1) {\n            array_push(_penalties, { name: _players[_threeManIdx], count: _drinkCount, reason: "CUSTOM LAW" });\n        } else if (_targetKey == "left") {\n            var _l = (_turnIdx - 1 + array_length(_players)) % array_length(_players);\n            array_push(_penalties, { name: _players[_l], count: _drinkCount, reason: "CUSTOM LAW" });\n        } else if (_targetKey == "right") {\n            var _r = (_turnIdx + 1) % array_length(_players);\n            array_push(_penalties, { name: _players[_r], count: _drinkCount, reason: "CUSTOM LAW" });\n        }\n    }\n\n    // --- COMMANDMENT 5: THE VIRGIN ROLL ---\n    if (array_length(_events) == 0 && _isVirgin) {\n        array_push(_events, "VIRGIN ROLL! DRINK 1 & GO AGAIN");\n        array_push(_penalties, { name: _players[_turnIdx], count: 1, reason: "VIRGIN" });\n    }\n\n    return { events: _events, newThreeManIdx: _newThreeManIdx, total: _total, threeManPenalty: _threeManPenalty, isDoubles: _isDoubles, penalties: _penalties, triggeredLaws: _triggeredLaws };\n}